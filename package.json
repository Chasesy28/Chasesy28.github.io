{
  "name": "chasesy28.github.io",
  "version": "1.0.0",
  "description": "This project is a basic testing site i use to mess around and test features. 🦄",
  "main": "Finder.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && sh scripts/copy-legacy-assets.sh",
    "preview": "vite preview",
    "preview:fresh": "sh -c 'if command -v fuser >/dev/null 2>&1; then fuser -k 4173/tcp >/dev/null 2>&1 || true; fi; npm run build && vite preview --host 0.0.0.0 --port 4173'",
    "build:preview": "npm run build && vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chasesy28/Chasesy28.github.io.git"
  },
